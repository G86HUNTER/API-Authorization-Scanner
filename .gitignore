# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Virtual environment
.venv/
venv/
env/
ENV/

# Pytest
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Reports — keep primary scan reports, ignore temp files and timestamped runs
reports/*.tmp
reports/scan_*.json
reports/scan_*.html

# Secrets — never commit these
*.env
.env
*.secret
secrets.yaml
credentials.yaml

# Logs
*.log
logs/

# Distribution / packaging
dist/
build/
*.egg-info/
